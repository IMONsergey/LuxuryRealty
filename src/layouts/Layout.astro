---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import {site,asset} from '../data/site';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/pages.css';
import '../styles/migration.css';
import '../styles/design-system.css';
import '../styles/motion.css';
interface Props {title?:string;description?:string;image?:string;bodyClass?:string;}
const {title=site.name,description=site.description,image=asset('imgRectangle6').src,bodyClass=''}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site||Astro.url.origin);
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="theme-color" content="#0d0d11" />
 <meta name="description" content={description} />
 <meta name="robots" content="noindex,follow" />
 <link rel="canonical" href={canonical} />
 <link rel="icon" type="image/svg+xml" href={asset('imgGroup1').src} />
 <link rel="preload" href="/fonts/sf-thin.woff2" as="font" type="font/woff2" crossorigin />
 <link rel="preload" href="/fonts/graphik-regular.woff2" as="font" type="font/woff2" crossorigin />
 <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={new URL(image,canonical).href} /><meta property="og:url" content={canonical} />
 <meta name="twitter:card" content="summary_large_image" />
 <title>{title===site.name?title:title+' | '+site.name}</title>
</head>
<body class={bodyClass}>
 <Header />
 <main id="main" tabindex="-1"><slot /></main>
 <Footer />
 <Dialogs />
 <script>import '../scripts/site';</script>
</body>
</html>
