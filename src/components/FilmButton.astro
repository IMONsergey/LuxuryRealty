---
import Icon from './Icon.astro';
interface Props{url:string;label?:string;title?:string;class?:string;}
const {url,label='Watch film',title='Property film',class:className=''}=Astro.props;
---
<button type="button" class:list={['button','button--outline',className]} data-film-url={url} data-film-title={title}><span>{label}</span><Icon name="arrow-up-right" size={20} /></button>
