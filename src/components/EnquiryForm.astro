---
interface Props {context?:string;id?:string;compact?:boolean;}
const {context='Private consultation',id='enquiry',compact=false}=Astro.props;
---
<form class:list={['enquiry-form',{'enquiry-form--compact':compact}]} data-enquiry-form data-context={context} method="post" action="/api/enquiry" novalidate>
 <div class="form-fields">
  <label for={id+'-name'}>Full name<input id={id+'-name'} name="name" autocomplete="name" placeholder="Your name" required minlength="2" maxlength="100" /><span class="field-error" data-error-for="name"></span></label>
  <label for={id+'-email'}>Email<input id={id+'-email'} name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" /><span class="field-error" data-error-for="email"></span></label>
  <label for={id+'-phone'}>Phone<input id={id+'-phone'} name="phone" type="tel" autocomplete="tel" placeholder="Country code and phone number" maxlength="30" /><span class="field-error" data-error-for="phone"></span></label>
  <label for={id+'-message'}>What would you like to discuss?<textarea id={id+'-message'} name="message" rows="2" maxlength="2000" placeholder="A property, a preferred date, a question…"></textarea></label>
 </div>
 <div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
 <label class="consent"><input type="checkbox" name="consent" required /><span>I agree to the processing of my enquiry as described in the <a href="/privacy/">privacy policy</a>.</span></label>
 <span class="field-error" data-error-for="consent"></span>
 <div class="form-actions"><button class="button button--solid" type="submit"><span data-submit-label>Send enquiry</span><span aria-hidden="true">→</span></button><p class="form-status" role="status" aria-live="polite"></p></div>
</form>
