---
import {articles} from '../data/articles';
import Picture from './Picture.astro';
interface Props {article:typeof articles[number];}
const {article:a}=Astro.props;
---
<article class="insight-card"><a href={'/insights/'+a.id+'/'}>
 <div class="insight-image"><Picture name={a.image} alt="" sizes="(max-width: 700px) calc(100vw - 48px), 350px" /></div>
 <p class="insight-meta">{a.category}<span>{a.minutes} min read</span></p>
 <h3>{a.title}</h3><p class="insight-excerpt">{a.excerpt}</p>
 <span class="insight-arrow" aria-hidden="true">↗</span>
</a></article>
