---
import type {Property} from '../data/site';
import {price} from '../data/site';
import Picture from './Picture.astro';
interface Props {property:Property;compact?:boolean;class?:string;}
const {property:p,compact=false,class:className=''}=Astro.props;
---
<article class:list={['property-card',{'property-card--compact':compact},className]} data-property-card data-id={p.id} data-purpose={p.purpose} data-type={p.type.toLowerCase()} data-location={p.location.toLowerCase()} data-bedrooms={p.bedrooms} data-price={p.price} data-features={p.features.join(',').toLowerCase()} data-search={(p.title+' '+p.subtitle+' '+p.location+' '+p.type+' '+p.features.join(' ')).toLowerCase()}>
 <a href={'/properties/'+p.id+'/'} class="property-card-link">
  <div class="property-media"><Picture name={p.image} alt={p.subtitle} sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 1000px) 45vw, 414px" /><div class="property-tags"><span>Exclusive</span><span>Great location</span></div></div>
  <div class="property-info"><h3>{p.title}</h3><p class="property-price">{price(p.price)}</p><p class="property-specs">{p.type} · {p.bedrooms} beds · {new Intl.NumberFormat('en-US').format(p.area)} sq.ft.</p><p class="property-location">{p.location}, Dubai</p></div>
 </a>
</article>
