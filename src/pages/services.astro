---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Button from '../components/Button.astro';
import {agencyServices,pageParagraphs} from '../data/content';
import '../styles/content.css';
const intro=pageParagraphs('services','about_services_component')[0];
const closing=pageParagraphs('services','before_footer_component');
const serviceLinks:Record<string,{label:string;href:string}[]>={
 'Residential Agency':[{label:'Buy a residence',href:'/properties/'},{label:'Find a rental',href:'/properties/?purpose=rent'},{label:'Sell with us',href:'/sell/'}],
 'Residential Development':[{label:'Explore developments',href:'/developments/'}],
};
---
<Layout title="Our services" description="Property sales and rentals, asset management, development, financial and legal introductions, and lifestyle services in Dubai.">
 <section class="page-hero page-hero--left editorial-hero"><div class="page-hero-back"><Picture name="contacts-imgOrlaProductFilmHr1000123235" eager /></div><div class="container"><p class="eyebrow">Considered at every step</p><h1>Our services</h1><p>Support for your property, your plans and the way you choose to live.</p></div></section>
 <section class="container editorial-intro"><h2>A broader<br/>perspective.</h2><div class="editorial-prose"><p>{intro}</p><p>Our team brings property advice and a network of specialist partners together around your individual requirements.</p></div></section>
 <section class="container service-detail-list" aria-label="Luxury Realty services">{agencyServices.map((service,index)=><article class="service-detail" id={'service-'+(index+1)}><span class="service-detail-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><h2>{service.title}</h2><div class="editorial-prose"><p>{service.body}</p><div class="service-links">{serviceLinks[service.title]?.map(link=><a class="text-link" href={link.href}>{link.label}</a>)}</div><Button context={service.title+' enquiry'} variant="outline">Discuss your requirements</Button></div></article>)}</section>
 <section class="container editorial-cta"><div><h2>A dedicated<br/>point of contact.</h2>{closing.map(paragraph=><p>{paragraph}</p>)}</div><Button context="Agency services consultation">Arrange a conversation</Button></section>
</Layout>
