---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import Button from '../../components/Button.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import FilmButton from '../../components/FilmButton.astro';
import {projects,currentProperties,asset,type Project} from '../../data/site';
import {getProjectContent} from '../../data/content';
import '../../styles/content.css';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.id},props:{project}}));}
const {project:p}=Astro.props as {project:Project};
const content=getProjectContent(p.id);
const gallery=content.photos.map((photo,index)=>({src:asset(photo.url).src,alt:photo.alt||p.name+' - project view '+(index+1),image:photo.url}));
const galleryData=JSON.stringify(gallery);
const firstPhotographedStory=content.story.findIndex(block=>block.images.length>0);
const openingStoryCount=firstPhotographedStory<0?content.story.length:firstPhotographedStory;
const openingStory=content.story.slice(0,openingStoryCount);
const illustratedStory=content.story.slice(openingStoryCount);
const residences=currentProperties.filter(property=>property.projectId===p.id&&!property.isDevelopment);
const hasRentals=residences.some(property=>property.purpose==='rent');
const residencePurpose=hasRentals?(residences.some(property=>property.purpose==='buy')?'all':'rent'):'buy';
const residenceCollectionUrl='/properties/?'+new URLSearchParams({purpose:residencePurpose,q:p.name}).toString();
const locationUrl='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(p.name+' '+p.location);
const heroImage=asset(p.image);
const heroWidth=heroImage.renderWidth||heroImage.width,heroHeight=heroImage.renderHeight||heroImage.height;
if(!heroWidth||!heroHeight)throw new Error('Missing project hero image dimensions: '+p.image);
const heroRatio=heroWidth/heroHeight;
const coverWidth=(height:number)=>Number((height*heroRatio).toFixed(2));
// object-fit:cover can display a wide photograph far wider than a narrow hero.
// Match the authored 740px/90svh mobile and 700px..900px desktop hero heights.
const heroSizes=`(max-width: 700px) max(100vw, ${coverWidth(740)}px, ${coverWidth(90)}svh), max(100vw, ${coverWidth(700)}px, min(${coverWidth(900)}px, ${coverWidth(100)}svh))`;
---
<Layout title={p.name} description={content.intro} image={heroImage.src}>
 <section class="development-detail-hero"><Picture name={p.image} alt={p.name+' architecture'} eager sizes={heroSizes} style={'object-position:'+p.position} /><div class="container"><p class="eyebrow">{p.location}</p><h1>{p.name}</h1><p>{p.subtitle}</p><a class="button button--outline" href="#discover"><span>Discover the project</span><span aria-hidden="true"><Icon name="arrow-down" /></span></a></div></section>
 <nav class="container project-section-nav" aria-label="On this project page"><a href="#discover">Overview</a><a href="#project-design">Architecture &amp; residences</a><a href="#project-amenities">Amenities</a><a href="#project-gallery">Gallery</a>{content.locationImages.length>0&&<a href="#project-location">Location</a>}{residences.length>0&&<a href="#project-residences">Current residences</a>}<a href="#project-enquiry">Enquire</a></nav>
 <section class="container development-intro section-space" id="discover"><div><a href="/developments/" class="back-link"><Icon name="arrow-left" /> All developments</a><h2>{content.title}</h2></div><div><p>{content.intro}</p><p>Explore the architecture, amenities and setting, then speak with your advisor about the residences and terms currently available.</p><Button context={p.name+' residence enquiry'}>Enquire about a residence</Button>{p.url&&<a class="text-link project-presentation-link" href={p.url} target="_blank" rel="noopener noreferrer">Open the project presentation <Icon name="arrow-up-right" size={18} /></a>}</div></section>
 <section class="container development-story-list" id="project-design" aria-label="Architecture and residences">
  {openingStory.length>0&&<div class="development-story-opening">{openingStory.map(block=><article><h2>{block.heading}</h2><div class="editorial-prose">{block.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></article>)}</div>}
  {illustratedStory.map((block,index)=><article class="development-story"><div class="development-story-content"><div><p class="eyebrow">{String(index+openingStoryCount+1).padStart(2,'0')} / {p.name}</p><h2>{block.heading}</h2></div><div class="editorial-prose">{block.paragraphs.map(paragraph=><p>{paragraph}</p>)}{block.id==='section_header137'&&<a class="text-link" href={locationUrl} target="_blank" rel="noopener noreferrer">Explore the location <Icon name="arrow-up-right" size={18} /></a>}</div></div>{block.images.length>0&&<button class="development-story-photo" type="button" data-gallery={galleryData} data-gallery-title={p.name} data-gallery-index={Math.max(0,gallery.findIndex(photo=>photo.image===block.images[0].url))} aria-label={'Open '+p.name+' project photograph'}><Picture name={block.images[0].url} alt={block.images[0].alt||p.name+' residence and setting'} sizes="(max-width: 700px) calc(100vw - 48px), 1110px" /><span aria-hidden="true"><Icon name="arrow-up-right" /></span></button>}</article>)}</section>
 {content.filmUrl&&<section class="container development-film"><div class="section-heading"><div><p class="eyebrow">The project on film</p><h2>Experience {p.name}</h2></div><FilmButton url={content.filmUrl} title={p.name+' project film'} label="Watch the project film" /></div></section>}
 <section class="container development-amenities" id="project-amenities" aria-labelledby="amenities-heading"><div class="section-heading"><h2 id="amenities-heading">{content.featureTitle}</h2><p>Spaces, services and considered details that shape everyday life.</p></div><div class="development-feature-grid">{content.features.map(feature=><article>{feature.image&&<Picture name={feature.image.url} alt={feature.image.alt||feature.heading} sizes="(max-width: 700px) calc(100vw - 48px), 350px" />}<h3>{feature.heading}</h3><p>{feature.body}</p></article>)}</div></section>
 <section class="container development-gallery" id="project-gallery" aria-labelledby="project-gallery-heading"><div class="section-heading"><h2 id="project-gallery-heading">A closer look</h2><button type="button" class="button button--outline" data-gallery={galleryData} data-gallery-title={p.name}><span>View all {gallery.length} photographs</span><Icon name="arrow-up-right" /></button></div><div class="development-gallery-grid">{gallery.slice(0,6).map((photo,index)=><button type="button" data-gallery={galleryData} data-gallery-title={p.name} data-gallery-index={index} aria-label={'Open project photograph '+(index+1)}><Picture name={photo.image} alt={photo.alt} sizes="(max-width: 700px) calc(100vw - 48px), 530px" /></button>)}</div></section>
 {content.locationImages.length>0&&<section class="container development-location" id="project-location" aria-labelledby="project-location-heading"><div class="development-location-copy"><p class="eyebrow">{p.name}</p><h2 id="project-location-heading">The location</h2><p>{p.location}</p><a class="text-link" href={locationUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps <Icon name="arrow-up-right" size={18} /></a></div><div class="development-location-maps">{content.locationImages.map(image=><figure><a class="development-location-map" href={asset(image.url).src} target="_blank" rel="noopener noreferrer" aria-label={'Open full location map for '+p.name}><Picture name={image.url} alt={image.alt||p.name+' location map'} sizes="(max-width: 700px) calc(100vw - 80px), 400px" /></a><figcaption>Open the map for a closer look.</figcaption></figure>)}</div></section>}
 {residences.length>0&&<section class="container development-residences" id="project-residences" aria-labelledby="residences-heading"><div class="section-heading"><h2 id="residences-heading">Residences<br/>in the collection.</h2><a class="text-link" href={residenceCollectionUrl}>Explore matching properties</a></div><div class="development-opportunity-grid">{residences.slice(0,6).map(property=><PropertyCard property={property} />)}</div></section>}
 <section class="container project-enquiry" id="project-enquiry" aria-labelledby="project-enquiry-heading"><div class="editorial-prose"><p class="eyebrow">Your next step</p><h2 id="project-enquiry-heading">{p.name}</h2><p>Request the current residence information, a brochure or floor plans. Your advisor can help you compare the available options and arrange a private consultation.</p></div><div class="project-enquiry-actions"><Button context={p.name+' private consultation'}>Arrange a consultation</Button>{content.brochureUrl?<Button href={content.brochureUrl} variant="outline">View brochure</Button>:<Button context={p.name+' brochure request'} variant="outline">Request brochure</Button>}{content.floorplansUrl?<Button href={content.floorplansUrl} variant="outline">View floor plans</Button>:<Button context={p.name+' floor plan request'} variant="outline">Request floor plans</Button>}</div></section>
 <section class="container other-developments"><div class="section-heading"><h2>Other perspectives</h2></div><div class="project-grid">{projects.filter(project=>project.id!==p.id).slice(0,2).map(project=><ProjectCard project={project} compact />)}</div></section>
</Layout>
