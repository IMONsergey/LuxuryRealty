---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Lettering from '../components/Lettering.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import {site} from '../data/site';
import {contactContent,agencySocialLinks,officeMapUrl} from '../data/content';
import '../styles/content.css';
---
<Layout title="Contacts" description="Get in touch with Luxury Realty to discuss a property, arrange a viewing or request a personal selection.">
 <section class="page-hero contacts-hero"><div class="page-hero-back"><Picture name="contacts-imgOrlaProductFilmHr1000123235" eager /></div><div class="container"><h1>Luxury Realty</h1><Lettering name="contacts" text="Contacts" /></div></section>
 <section class="container contact-grid" aria-labelledby="contact-title"><div class="contact-details"><h2 id="contact-title">A personal<br/>conversation.</h2><dl><dt>Office</dt><dd><a href={'tel:'+site.phoneHref}>{site.phone}</a></dd><dt>Email</dt><dd><a href={'mailto:'+site.email}>{site.email.split('@')[0]}@<wbr /><span class="email-domain">{site.email.split('@')[1]}</span></a></dd><dt>Visit us</dt><dd>{site.address}</dd>{contactContent.legalName&&<><dt>Registered company</dt><dd class="contact-legal-name">{contactContent.legalName}</dd></>}</dl><p>Tell us what you have in mind. Request a private viewing, discuss a particular project or find support for your next move.</p>{agencySocialLinks.length>0&&<nav class="contact-socials" aria-label="Follow the agency">{agencySocialLinks.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</nav>}</div><div class="contact-form-panel"><p class="eyebrow">Let’s begin</p><h2>A touch of perfection</h2><EnquiryForm id="contact-enquiry" context="Website contact enquiry" /></div></section>
 <section class="container contact-map-section"><div class="office-location"><div><p class="eyebrow">Barsha Heights, Dubai</p><h2>Visit our office</h2><p>{site.address}</p><p class="muted">Contact the team to arrange a convenient time.</p></div><a class="button button--outline" href={officeMapUrl} target="_blank" rel="noopener noreferrer"><span>Open in Google Maps</span><Icon name="arrow-up-right" size={20} /></a></div></section>
</Layout>
