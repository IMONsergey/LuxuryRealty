---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Lettering from '../components/Lettering.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import {site} from '../data/site';
---
<Layout title="Contacts" description="Get in touch with Luxury Realty to discuss a property, arrange a viewing or request a personal selection.">
 <section class="page-hero contacts-hero"><div class="page-hero-back"><Picture name="contacts-imgOrlaProductFilmHr1000123235" eager /></div><div class="container"><h1>Luxury Realty</h1><Lettering name="contacts" text="Contacts" /></div></section>
 <section class="container contact-grid" aria-labelledby="contact-title"><div class="contact-details"><h2 id="contact-title">A personal<br/>conversation.</h2><dl><dt>Office</dt><dd><a href={'tel:'+site.phoneHref}>{site.phone}</a></dd><dt>Email</dt><dd><a href={'mailto:'+site.email}>{site.email.split('@')[0]}@<wbr /><span class="email-domain">{site.email.split('@')[1]}</span></a></dd><dt>Visit us</dt><dd>{site.address}</dd></dl><p>Tell us what you have in mind. Request a private viewing, a particular project or help exploring your next home.</p></div><div class="contact-form-panel"><p class="eyebrow">Let’s begin</p><h2>A touch of perfection</h2><EnquiryForm id="contact-enquiry" context="Website contact enquiry" /></div></section>
 <section class="container contact-map-section"><h2 class="sr-only">Find our office</h2><a class="contact-map" href="https://www.google.com/maps/search/?api=1&query=One+Central+Offices+5+Dubai" target="_blank" rel="noopener noreferrer"><Picture name="contacts-imgRectangle66" alt="Map showing the Luxury Realty office in Dubai" /><span class="map-link">Open in Google Maps <span aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span></span></a></section>
</Layout>
