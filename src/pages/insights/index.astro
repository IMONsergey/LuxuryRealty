---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import Lettering from '../../components/Lettering.astro';
import InsightCard from '../../components/InsightCard.astro';
import Button from '../../components/Button.astro';
import {articles} from '../../data/articles';
---
<Layout title="Luxury Realty Insights" description="Thoughtful perspectives on homes, architecture and life in Dubai.">
 <section class="page-hero"><div class="page-hero-back"><Picture name="insights-imgOrlaProductFilmHr1000123234" eager /></div><div class="container"><p class="eyebrow">Stories & perspectives</p><h1>Luxury Realty<br/>Insights</h1></div></section>
 <section class="container insights-page" data-insights><div class="insights-filters" role="group" aria-label="Filter insights by topic">{['All','Architecture','Places','Living'].map((category,i)=><button type="button" data-category={category.toLowerCase()} aria-pressed={i===0?'true':'false'}>{category}</button>)}</div><div class="insights-grid">{articles.map(article=><div data-insight-category={article.category.toLowerCase()}><InsightCard article={article} /></div>)}</div></section>
 <section class="container subscribe-panel"><div><Lettering name="subscribe" text="Subscribe" /><h2>Stay inspired.</h2><p>Tell us which places and properties interest you, and request a personal selection.</p></div><Button context="Request a personal property selection">Keep in touch</Button></section>
</Layout>
