---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import Picture from '../components/Picture.astro';
import Lettering from '../components/Lettering.astro';
import Button from '../components/Button.astro';
import PropertyCard from '../components/PropertyCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Consultation from '../components/Consultation.astro';
import InsightCard from '../components/InsightCard.astro';
import {properties,projects,services,asset} from '../data/site';
import {articles} from '../data/articles';
const selection=properties.slice(0,5).map((p,i)=>({...p,image:['imgRectangle4','imgRectangle7','imgRectangle8','imgRectangle5','imgRectangle11'][i]}));
const storyImages=[{src:asset('imgRectangle25').src,alt:'A considered interior with natural textures'},{src:asset('imgRectangle26').src,alt:'The architecture of a private residence'}];
---
<Layout bodyClass="home-page">
 <section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero-image" data-hero-parallax><Picture name="imgRectangle6" alt="Palm Jumeirah and the Dubai coastline at dusk" sizes="(max-width: 700px) 1500px, 100vw" eager /><div></div></div>
  <div class="container hero-content">
   <h1 id="home-title" data-hero-title><span>Elegant Luxury</span><span>properties in the heart</span></h1>
   <Lettering name="of-dubai" text="of Dubai" class="hero-lettering" />
   <p class="hero-intro">We offer the most exclusive selection of high-end real estate in Dubai, tailored to your individual needs.</p>
   <form class="hero-search" action="/properties/" method="get" role="search" aria-label="Find a property">
    <label class="search-purpose"><span class="sr-only">Buy or rent</span><select name="purpose"><option value="buy">Buy</option><option value="rent">Rent</option></select><span aria-hidden="true">⌄</span></label>
    <label class="search-query"><span class="sr-only">Property or location</span><input name="q" type="search" placeholder="Enter a location, community or property" maxlength="100" /></label>
    <a class="search-filter" href="/properties/#filters" aria-label="Open advanced property filters"><svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M3 6h16M3 16h16M8 3v6M14 13v6" stroke="currentColor" stroke-width="1.5"/></svg></a>
    <button type="submit">Search<span aria-hidden="true">→</span></button>
   </form>
   <a class="hero-mobile-search button button--solid" href="/properties/"><span>Find your perfect property</span><span aria-hidden="true">→</span></a>
   <a class="hero-scroll" href="#selection"><span>Scroll to discover</span><span aria-hidden="true">↓</span></a>
  </div>
 </section>
 <section class="selections" id="selection" aria-labelledby="selection-title">
  <div class="selection-heading container" data-reveal><h2 id="selection-title">Real Estate</h2><Lettering name="selections" text="Selections" /><p>Exceptional homes. Individual stories.</p></div>
  <div class="selection-rail" data-rail aria-label="Selected properties" tabindex="0">{selection.map(p=><PropertyCard property={p} compact />)}</div>
  <div class="container selection-actions"><div class="rail-controls"><button class="round-control" type="button" data-rail-prev=".selection-rail" aria-label="Previous properties">←</button><button class="round-control" type="button" data-rail-next=".selection-rail" aria-label="Next properties">→</button></div><Button href="/properties/" variant="text">Explore the collection</Button></div>
 </section>
 <section class="home-developments" aria-labelledby="developments-title">
  <div class="development-sculpture"><Picture name="img1" /></div>
  <div class="container">
   <div class="section-heading" data-reveal><h2 id="developments-title">New developments<br/>in Dubai</h2><p>Discover extraordinary places to call home. A considered collection of residences, architecture and distinctive perspectives on life in Dubai.</p></div>
   <div class="project-stack">{projects.slice(0,3).map(project=><ProjectCard project={project} />)}</div>
   <div class="project-more"><Button href="/developments/" variant="text">View all developments</Button></div>
  </div>
 </section>
 <section class="container home-services section-space" id="services" aria-labelledby="services-title">
  <div class="section-heading" data-reveal><h2 id="services-title">Our services</h2><p>A personal approach, from your first conversation to a closer look at the right property.</p></div>
  <div class="service-list">{services.map((service,i)=><details class="service" name="services" open={i===0}><summary><span class="service-number">{String(i+1).padStart(2,'0')}</span><h3>{service.title}</h3><span class="service-symbol" aria-hidden="true">+</span></summary><div class="service-body"><p>{service.body}</p><Button context={service.title} variant="text">Let’s talk</Button></div></details>)}</div>
 </section>
 <section class="home-story" id="story" aria-labelledby="story-title">
  <div class="story-back"><Picture name="imgRectangle21" /></div>
  <div class="container">
   <div class="story-heading" data-reveal><Lettering name="about-agency" text="About Agency" /><h2 id="story-title">Luxury Realty</h2></div>
   <div class="story-layout">
    <button class="story-collage" type="button" data-gallery={JSON.stringify(storyImages)} data-gallery-title="A considered perspective" aria-label="Explore our approach in photographs">
     <Picture name="imgRectangle25" alt="A sculptural interior" class="story-photo-one" /><Picture name="imgRectangle26" alt="Architecture with an individual perspective" class="story-photo-two" /><span class="story-brand"><Picture name="imgGroup24" /><span>Explore our perspective <span aria-hidden="true">↗</span></span></span>
    </button>
    <div class="story-copy" data-reveal><p>To provide best-in-class real estate services to our valued clients as your trusted expert advisors. Collectively, we are powered by data driven insights to meet your individual requirements in a refreshingly transparent and personalised manner.</p><p>Our approach connects a considered selection of homes with a personal conversation, helping you explore the places and details that matter to you.</p><Button href="/contacts/" variant="outline">About our agency</Button></div>
   </div>
  </div>
 </section>
 <Consultation />
 <section class="home-insights section-space" aria-labelledby="insights-title">
  <div class="container section-heading" data-reveal><h2 id="insights-title">Luxury Realty Insights</h2><div class="rail-controls"><button class="round-control" type="button" data-rail-prev=".insight-rail" aria-label="Previous insights">←</button><button class="round-control" type="button" data-rail-next=".insight-rail" aria-label="Next insights">→</button></div></div>
  <div class="insight-rail" data-rail aria-label="Latest insights" tabindex="0">{articles.map(article=><InsightCard article={article} />)}</div>
  <div class="container insights-more"><Button href="/insights/" variant="text">All insights</Button></div>
 </section>
</Layout>
