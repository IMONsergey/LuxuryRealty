---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import Lettering from '../../components/Lettering.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Consultation from '../../components/Consultation.astro';
import {properties} from '../../data/site';
---
<Layout title="Dubai real estate" description="Explore illustrative property previews. Verified listings, locations, pricing and availability are confirmed separately.">
 <section class="page-hero"><div class="page-hero-back"><Picture name="imgRectangle21" eager /></div><div class="container"><Lettering name="dubai" text="Dubai" /><h1>Real Estate</h1><p>A considered selection of exceptional places to call home.</p></div></section>
 <p class="container collection-disclaimer" role="note">Illustrative catalogue preview. These sample entries are not verified property listings. Prices, locations, specifications, images and availability must be confirmed with the owner.</p>
 <section class="container catalogue" data-catalogue aria-label="Property collection">
  <div class="catalogue-top"><div class="purpose-tabs" role="group" aria-label="Transaction type"><button type="button" data-purpose="buy" aria-pressed="true">Buy examples</button><button type="button" data-purpose="rent" aria-pressed="false">Rent</button></div><p class="result-count" role="status" data-result-count>{properties.length} properties</p><label class="sort-label">Sort by<select name="sort" data-sort><option value="featured">Featured</option><option value="name">Name</option></select></label></div>
  <div class="catalogue-layout">
   <aside class="catalogue-sidebar" id="filters">
    <details class="filter-disclosure" open><summary>Refine your search<span aria-hidden="true"><Icon name="plus" /></span></summary>
     <form class="filter-form" data-filters method="get" action="/properties/">
      <input type="hidden" name="purpose" value="buy" />
      <label class="filter-label">Location or keyword<input name="q" type="search" placeholder="Search the collection" maxlength="100" /></label>
      <details class="filter-group" open hidden><summary>Property type<span><Icon name="chevron-down" size={16} /></span></summary><label><input type="checkbox" name="type" value="villa" />Villa</label><label><input type="checkbox" name="type" value="apartment" />Apartment</label><label><input type="checkbox" name="type" value="penthouse" />Penthouse</label></details>
      <details class="filter-group" open hidden><summary>Bedrooms<span><Icon name="chevron-down" size={16} /></span></summary><div class="bedroom-options">{['Any','1','2','3','4','5','6+'].map((n,i)=><label><input type="radio" name="beds" value={i===0?'':String(i)} checked={i===0} /><span>{n}</span></label>)}</div></details>
      <details class="filter-group" open hidden><summary>Price range, AED<span><Icon name="chevron-down" size={16} /></span></summary><div class="price-inputs"><label><span class="sr-only">Minimum price</span><input name="min" type="number" min="0" max="1000000000" step="1" placeholder="From" /></label><span aria-hidden="true">–</span><label><span class="sr-only">Maximum price</span><input name="max" type="number" min="0" max="1000000000" step="1" placeholder="To" aria-describedby="price-range-error" /></label></div><p id="price-range-error" class="field-error" data-filter-error></p></details>
      <details class="filter-group" hidden><summary>Features<span><Icon name="chevron-down" size={16} /></span></summary>{['Pool','Garden','Terrace','Water view','City view','Open kitchen'].map(feature=><label><input type="checkbox" name="features" value={feature.toLowerCase()} />{feature}</label>)}</details>
      <p class="filter-live-note" aria-live="polite">Results update as you refine your search.</p><button class="reset-filters" type="reset">Reset all filters</button>
     </form>
    </details>
   </aside>
   <div class="catalogue-results"><div class="property-grid" data-property-grid>{properties.map(property=><PropertyCard property={property} />)}<div class="empty-state" data-invalid-range hidden><p class="eyebrow">Refine your search</p><h2>Check the price range</h2><p>The minimum price must not exceed the maximum. Adjust the filters to see properties.</p></div><div class="empty-state" data-no-results hidden><p class="eyebrow">Let’s make it personal</p><h2 data-empty-title>No matching examples</h2><p data-empty-copy>Try fewer filters, or request a tailored selection. All current catalogue entries are illustrative previews.</p><button class="button button--outline" type="button" data-enquiry="Personal property search"><span>Request a selection</span><span aria-hidden="true"><Icon name="arrow-right" /></span></button></div></div>
    <p class="collection-note">All entries are illustrative examples, not live listings. Verified inventory, prices, specifications and availability must be confirmed separately.</p>
   </div>
  </div>
 </section>
 <Consultation />
</Layout>
