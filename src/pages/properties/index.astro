---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import Lettering from '../../components/Lettering.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Consultation from '../../components/Consultation.astro';
import {properties} from '../../data/site';
---
<Layout title="Dubai real estate" description="Explore illustrative property previews. Verified listings, locations, pricing and availability are confirmed separately.">
 <section class="page-hero"><div class="page-hero-back"><Picture name="imgRectangle21" eager /></div><div class="container"><Lettering name="dubai" text="Dubai" /><h1>Real Estate</h1><p>A considered selection of exceptional places to call home.</p></div></section>
 <p class="container collection-disclaimer" role="note">Illustrative catalogue preview. These sample entries are not verified property listings. Prices, locations, specifications, images and availability must be confirmed with the owner.</p>
 <section class="container catalogue" data-catalogue aria-label="Property collection">
  <div class="catalogue-top"><div class="purpose-tabs" role="group" aria-label="Transaction type"><button type="button" data-purpose="buy" aria-pressed="true">Buy examples</button><button type="button" data-purpose="rent" aria-pressed="false">Rent</button></div><p class="result-count" role="status" data-result-count>{properties.length} properties</p><label class="sort-label">Sort by<select name="sort" data-sort><option value="featured">Featured</option><option value="name">Name</option></select></label></div>
  <div class="catalogue-layout">
   <aside class="catalogue-sidebar" id="filters">
    <details class="filter-disclosure" open><summary>Refine your search<span aria-hidden="true"><Icon name="plus" /></span></summary>
     <form class="filter-form" data-filters method="get" action="/properties/">
      <input type="hidden" name="purpose" value="buy" />
      <label class="filter-label">Location or keyword<input name="q" type="search" placeholder="Search the collection" maxlength="100" /></label>
      <p class="filter-live-note" aria-live="polite">Results update as you refine your search.</p><button class="reset-filters" type="reset">Reset all filters</button>
     </form>
    </details>
   </aside>
   <div class="catalogue-results"><div class="property-grid" data-property-grid>{properties.map(property=><PropertyCard property={property} />)}<div class="empty-state" data-no-results hidden><p class="eyebrow">Let’s make it personal</p><h2 data-empty-title>No matching examples</h2><p data-empty-copy>Try fewer filters, or request a tailored selection. All current catalogue entries are illustrative previews.</p><button class="button button--outline" type="button" data-enquiry="Personal property search"><span>Request a selection</span><span aria-hidden="true"><Icon name="arrow-right" /></span></button></div></div>
    <p class="collection-note">All entries are illustrative examples, not live listings. Verified inventory, prices, specifications and availability must be confirmed separately.</p>
   </div>
  </div>
 </section>
 <Consultation />
</Layout>
