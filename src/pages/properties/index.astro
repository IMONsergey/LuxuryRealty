---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import Lettering from '../../components/Lettering.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Consultation from '../../components/Consultation.astro';
import FilterDialog from '../../components/FilterDialog.astro';
import {properties} from '../../data/site';
import {defaultFilters,filterOptions,matchingProperties,propertyFilterRecord} from '../../data/property-filters';
import '../../styles/catalogue.css';
const records=properties.map(propertyFilterRecord);
const options=filterOptions(records);
const currentBuy=matchingProperties(records,defaultFilters());
const initialIds=new Set(currentBuy.slice(0,24).map(property=>property.id));
---
<Layout title="Dubai properties for sale and rent" description="Explore homes for sale and rent in Dubai. Search by community, property type, bedrooms and price, with photographs and details for each residence.">
 <section class="page-hero page-hero--collection"><div class="page-hero-back"><Picture name="imgRectangle21" eager /></div><div class="container"><Lettering name="dubai" text="Dubai" /><h1>Real Estate</h1><p>Find a home that reflects the way you want to live.</p></div></section>
 <section class="container catalogue" data-catalogue data-page-size="24" aria-label="Property collection">
  <div class="collection-controls" id="filters">
   <div class="collection-tabs" role="group" aria-label="Transaction type">
    <button type="button" data-purpose="buy" aria-pressed="true">Buy</button><button type="button" data-purpose="rent" aria-pressed="false">Rent</button><button type="button" data-purpose="developments" aria-pressed="false">New developments</button><button type="button" data-purpose="all" aria-pressed="false">All</button>
   </div>
   <div class="collection-toolbar">
    <form class="collection-quick-search" data-quick-filters role="search" aria-label="Search the collection" action="/properties/" method="get">
     <input type="hidden" name="purpose" value="buy" />
     <div class="collection-query"><label class="sr-only" for="collection-query-input">Search properties</label><input id="collection-query-input" type="search" name="q" maxlength="100" placeholder="Name, community or reference" autocomplete="off" /><button type="submit" aria-label="Search collection"><img src="/assets/hero-search.svg" width="20" height="20" alt="" aria-hidden="true" /></button></div>
     <label class="collection-location"><span class="sr-only">Filter by location</span><select name="location"><option value="">All locations</option>{options.location.map(location=><option value={location}>{location}</option>)}</select><Icon name="chevron-down" size={18} /></label>
    </form>
    <button type="button" class="collection-filter-trigger" data-filter-open aria-controls="catalogue-filter-dialog" aria-haspopup="dialog"><img src="/assets/hero-filter.svg" width="18" height="18" alt="" aria-hidden="true" /><span>Filters</span><span class="collection-filter-badge" data-filter-badge hidden>0</span></button>
   </div>
   <div class="collection-applied"><div class="collection-active-filters" data-active-filters aria-label="Selected filters" hidden></div><button type="button" class="collection-clear" data-clear-filters hidden>Clear all</button></div>
  </div>
  <p class="catalogue-link-notice" data-query-notice role="status" hidden></p>
  <noscript><p class="catalogue-link-notice">JavaScript is needed to use the filters. All catalogue records are shown below.</p><style is:inline>.catalogue [data-property-card][hidden]{display:flex!important}.catalogue [data-pagination],.catalogue [data-page-summary],.collection-controls,.collection-results-heading{display:none!important}</style></noscript>
  <div class="catalogue-results" data-results-start tabindex="-1">
   <div class="collection-results-heading"><p class="collection-count" role="status" aria-live="polite" aria-atomic="true" data-result-count>{currentBuy.length} {currentBuy.length===1?'property':'properties'}</p><label class="collection-sort"><span>Sort by</span><span><select name="sort" data-sort><option value="featured">Featured</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="name">Property name</option></select><Icon name="chevron-down" size={16} /></span></label></div>
   <div class="property-grid" data-property-grid>{properties.map(property=><PropertyCard property={property} hidden={!initialIds.has(property.id)} />)}<div class="empty-state" data-no-results hidden={currentBuy.length>0}><p class="eyebrow">A more personal search</p><h2 data-empty-title>No matching properties</h2><p data-empty-copy>Try a different location or a wider price range. Our team can also help you find a home that meets your requirements.</p><button class="button button--outline" type="button" data-enquiry="Personal property search"><span>Request a selection</span><span aria-hidden="true"><Icon name="arrow-right" /></span></button><button type="button" class="empty-reset text-link" data-empty-reset>Clear your filters</button></div></div>
   <div class="catalogue-pagination"><p data-page-summary>{currentBuy.length>0?'Showing 1-'+Math.min(24,currentBuy.length)+' of '+currentBuy.length+' properties':''}</p><nav aria-label="Property pages" data-pagination></nav></div>
   <p class="collection-note">Price and availability are confirmed on enquiry. Sold and rented homes remain in the archive and can be found using the listing status filter.</p>
  </div>
 </section>
 <FilterDialog context="catalogue" />
 <Consultation />
</Layout>
