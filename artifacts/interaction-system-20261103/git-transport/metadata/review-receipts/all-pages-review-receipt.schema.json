{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luxury Realty actual visual review receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "reviewer",
    "status",
    "captureBinding",
    "reviewedSheets",
    "nativeInspections",
    "findings",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewer": {
      "enum": [
        "/root",
        "/root/filters_ux",
        "/root/navigation_motion",
        "/root/qa_interaction_audit"
      ]
    },
    "status": {
      "enum": [
        "in-progress",
        "complete-for-assigned-overviews",
        "blocked"
      ]
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "captureBinding": {
      "type": "object",
      "required": [
        "sourceHead",
        "captureReportPath",
        "captureReportSha256",
        "sheetManifestPath",
        "sheetManifestSha256"
      ],
      "properties": {
        "sourceHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "captureReportPath": {
          "type": "string"
        },
        "captureReportSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sheetManifestPath": {
          "type": "string"
        },
        "sheetManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "allocationBinding": {
      "type": "object",
      "properties": {
        "planPath": {
          "type": "string"
        },
        "planSha256": {
          "type": "string"
        },
        "assignedSheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reviewedSheets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "viewedAt",
          "method",
          "reviewLevel",
          "overviewCoverage",
          "observations"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "viewedAt": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "reviewLevel": {
            "const": "scaled-structural-overview"
          },
          "overviewCoverage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "route",
                "viewportWidth",
                "state",
                "originalFile",
                "originalSha256",
                "scaleX",
                "scaleY"
              ],
              "properties": {
                "route": {
                  "type": "string"
                },
                "viewportWidth": {
                  "enum": [
                    390,
                    1440
                  ]
                },
                "state": {
                  "enum": [
                    "top",
                    "full"
                  ]
                },
                "originalFile": {
                  "type": "string"
                },
                "originalSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "scaleX": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "scaleY": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nativeInspections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "viewedAt",
          "route",
          "viewportWidth",
          "state",
          "region",
          "method",
          "observations"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "viewedAt": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "viewportWidth": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "region": {
            "oneOf": [
              {
                "const": "entire viewport PNG"
              },
              {
                "const": "entire original full PNG"
              },
              {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "width",
                  "height",
                  "cropFile",
                  "cropSha256",
                  "resized"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "cropFile": {
                    "type": "string"
                  },
                  "cropSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "resized": {
                    "const": false
                  }
                }
              }
            ]
          },
          "method": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "status",
          "observation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "observation"
            ]
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "not-a-defect"
            ]
          },
          "observation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "assignedSheetCount",
        "actualViewedSheetCount",
        "unreadSheets",
        "overviewRoutes",
        "overviewRouteWidthStates",
        "nativeInspectionCount"
      ],
      "properties": {
        "assignedSheetCount": {
          "type": "integer",
          "minimum": 0
        },
        "actualViewedSheetCount": {
          "type": "integer",
          "minimum": 0
        },
        "unreadSheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overviewRoutes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "overviewRouteWidthStates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "route",
              "viewportWidth",
              "state"
            ]
          }
        },
        "nativeInspectionCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "releaseAcceptance": {
      "const": false
    }
  },
  "$comment": "Individual receipts describe their bounded actual inspection. The release owner separately aggregates complete route coverage, current machine gates and resolved findings. Recompute coverage from unique reviewed sheet SHA/placement entries instead of trusting supplied counts."
}
